rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connectivity check
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User-partitioned storage
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) 
          && incoming().userId == userId
          && incoming().principal is number && incoming().principal > 0;
        allow update: if isOwner(userId) && isValidId(transactionId) 
          && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Agents
      match /agents/{agentId} {
        allow get: if isOwner(userId) && isValidId(agentId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(agentId) 
          && incoming().userId == userId
          && incoming().name is string && incoming().name.size() <= 100;
        allow delete: if isOwner(userId) && isValidId(agentId);
      }

      // Investors
      match /investors/{investorId} {
        allow get: if isOwner(userId) && isValidId(investorId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(investorId) 
          && incoming().userId == userId
          && incoming().name is string && incoming().name.size() <= 100;
        allow delete: if isOwner(userId) && isValidId(investorId);
      }

      // Audit Activity Logs
      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) 
          && incoming().userId == userId
          && incoming().action is string;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Settings
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(settingId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId) 
          && incoming().userId == userId;
        allow delete: if false;
      }
    }
  }
}
